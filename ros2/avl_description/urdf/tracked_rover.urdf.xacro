<?xml version="1.0"?>
<!--
  Tracked rover for AVL Autonomy Sim.

  Chassis geometry came from Paarseus/IGVC_ROS2
  src/avros_bringup/urdf/avros.urdf.xacro (Parsa Ghasemi, MIT).

  Sensor frame names follow assets/urdf/frames.md. Mount transforms stay at
  0 0 0 until they are measured and recorded in assets/measurements.md.
  ZED optical frames use the normal ROS optical-frame orientation.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracked_rover">

  <!-- IMU height above ground. Source comment: 21.875 in. -->
  <xacro:property name="xsens_height" value="0.5556"/>

  <!-- Main chassis box: 29.25 x 26.75 x 14.75 in -->
  <xacro:property name="main_length" value="0.7430"/>
  <xacro:property name="main_width"  value="0.6795"/>
  <xacro:property name="main_height" value="0.3747"/>

  <!-- Top sensor platform: 23.00 x 22.50 x 5.75 in -->
  <xacro:property name="top_length" value="0.5842"/>
  <xacro:property name="top_width"  value="0.5715"/>
  <xacro:property name="top_height" value="0.1461"/>

  <!-- Tread enclosures: 32.5 x 3.5 x 5.5 in, centered ±0.3653 m off centerline -->
  <xacro:property name="tread_length" value="0.8255"/>
  <xacro:property name="tread_width"  value="0.0889"/>
  <xacro:property name="tread_height" value="0.1397"/>
  <xacro:property name="tread_y"      value="0.3653"/>

  <link name="base_link">
    <visual>
      <origin xyz="0.3143 0 ${xsens_height - 0.2191}" rpy="0 0 0"/>
      <geometry>
        <box size="${main_length} ${main_width} ${main_height}"/>
      </geometry>
      <material name="grey"><color rgba="0.55 0.55 0.55 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.3143 0 ${xsens_height - 0.2191}" rpy="0 0 0"/>
      <geometry>
        <box size="${main_length} ${main_width} ${main_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.1143 0 ${xsens_height + 0.0413}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
      <material name="light_grey"><color rgba="0.70 0.70 0.70 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.1143 0 ${xsens_height + 0.0413}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.3143 ${tread_y} ${xsens_height - 0.4763}" rpy="0 0 0"/>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.3143 ${-tread_y} ${xsens_height - 0.4763}" rpy="0 0 0"/>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Source placeholder, not a measured mass. -->
    <inertial>
      <mass value="150.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="25.0"/>
    </inertial>
  </link>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- TODO measure: replace the zero mount from assets/measurements.md. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.06 0.06 0.03"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- TODO measure: replace the zero mount from assets/measurements.md. -->
  <link name="velodyne">
    <visual>
      <geometry><cylinder radius="0.052" length="0.072"/></geometry>
      <material name="velodyne_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
  </link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- TODO measure: replace the zero mount from assets/measurements.md. -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Camera boxes stand in for zed_wrapper's zed_macro. -->
  <link name="zed_center_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="zed_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_center_link"/>
    <!-- TODO measure -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="zed_left_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"/>
    </visual>
  </link>
  <joint name="zed_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_left_link"/>
    <!-- TODO measure -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="zed_right_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"/>
    </visual>
  </link>
  <joint name="zed_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_right_link"/>
    <!-- TODO measure -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optical frames: x right, y down, z forward. -->
  <link name="zed_left_optical_frame"/>
  <joint name="zed_left_optical_joint" type="fixed">
    <parent link="zed_left_link"/>
    <child link="zed_left_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="zed_center_optical_frame"/>
  <joint name="zed_center_optical_joint" type="fixed">
    <parent link="zed_center_link"/>
    <child link="zed_center_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="zed_right_optical_frame"/>
  <joint name="zed_right_optical_joint" type="fixed">
    <parent link="zed_right_link"/>
    <child link="zed_right_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Track stand-ins. Separation is the surveyed tread centerline spacing. -->
  <xacro:property name="wheel_radius" value="${tread_height / 2}"/>
  <xacro:property name="wheel_separation" value="${tread_y * 2}"/>

  <xacro:macro name="drive_wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${tread_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${tread_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Four contacts so the chassis cannot pitch onto its nose. -->
  <xacro:drive_wheel prefix="left_rear" x="-0.05" y="${tread_y}"/>
  <xacro:drive_wheel prefix="left_front" x="0.55" y="${tread_y}"/>
  <xacro:drive_wheel prefix="right_rear" x="-0.05" y="${-tread_y}"/>
  <xacro:drive_wheel prefix="right_front" x="0.55" y="${-tread_y}"/>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_rear_wheel_joint</left_joint>
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
    </plugin>
  </gazebo>

</robot>
