<?xml version="1.0"?>
<!--
  Tracked rover for AVL Autonomy Sim.

  Chassis geometry came from Paarseus/IGVC_ROS2
  src/avros_bringup/urdf/avros.urdf.xacro (Parsa Ghasemi, MIT).

  Every mechanical number lives in ../config/marvin_v1.yaml (model:=v1, the default),
  each with its source code from assets/measurements.md. Mount numbers there are
  IGVC stand-ins (avros.urdf.xacro / avros_cam_sim). Mass is 49 kg.
  Camera link names are the ones MARVIN published on /tf_static in the 21 October bags.
  No GPS link: /gnss uses imu_link (Ryan, 21 October).
  ZED optical frames use the normal ROS optical-frame orientation.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracked_rover">

  <!-- Which parameter file to read: config/marvin_v1.yaml unless the command line says otherwise -->
  <xacro:arg name="model" default="v1"/>
  <xacro:property name="p" value="${xacro.load_yaml('../config/marvin_$(arg model).yaml')}"/>

  <!-- IMU height above ground. Source comment: 21.875 in. -->
  <xacro:property name="xsens_height" value="${p['imu_height']}"/>

  <!-- Main chassis box: 29.25 x 26.75 x 14.75 in -->
  <xacro:property name="main_length" value="${p['main_length']}"/>
  <xacro:property name="main_width"  value="${p['main_width']}"/>
  <xacro:property name="main_height" value="${p['main_height']}"/>

  <!-- Top sensor platform: 23.00 x 22.50 x 5.75 in -->
  <xacro:property name="top_length" value="${p['top_length']}"/>
  <xacro:property name="top_width"  value="${p['top_width']}"/>
  <xacro:property name="top_height" value="${p['top_height']}"/>

  <!-- Tread enclosures: 32.5 x 3.5 x 5.5 in, centered ±half the track width off centerline -->
  <xacro:property name="tread_length" value="${p['tread_length']}"/>
  <xacro:property name="tread_width"  value="${p['tread_width']}"/>
  <xacro:property name="tread_height" value="${p['tread_height']}"/>
  <xacro:property name="tread_y"      value="${p['track_width'] / 2}"/>

  <link name="base_link">
    <visual>
      <origin xyz="${p['main_x']} 0 ${xsens_height - p['main_z_below_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${main_length} ${main_width} ${main_height}"/>
      </geometry>
      <material name="grey"><color rgba="0.55 0.55 0.55 1"/></material>
    </visual>
    <collision>
      <origin xyz="${p['main_x']} 0 ${xsens_height - p['main_z_below_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${main_length} ${main_width} ${main_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="${p['top_x']} 0 ${xsens_height + p['top_z_above_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
      <material name="light_grey"><color rgba="0.70 0.70 0.70 1"/></material>
    </visual>
    <collision>
      <origin xyz="${p['top_x']} 0 ${xsens_height + p['top_z_above_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="${p['tread_x']} ${tread_y} ${xsens_height - p['tread_z_below_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <visual>
      <origin xyz="${p['tread_x']} ${-tread_y} ${xsens_height - p['tread_z_below_imu']}" rpy="0 0 0"/>
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Whole robot is 49 kg. Four wheels are 1 kg each, so this link is 45 kg.
         Inertia is the IGVC placeholder scaled by 45/150, not a CAD inertia. -->
    <inertial>
      <mass value="${p['body_mass']}"/>
      <inertia ixx="${p['body_inertia'].split()[0]}" ixy="0" ixz="0" iyy="${p['body_inertia'].split()[1]}" iyz="0" izz="${p['body_inertia'].split()[2]}"/>
    </inertial>
  </link>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IGVC stand-in from avros_cam_sim / avros.urdf.xacro. Not a measurements.md value. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.06 0.06 0.03"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${xsens_height}" rpy="0 0 0"/>
  </joint>

  <!-- Xsens IMU and GNSS, following Paarseus/IGVC_ROS2 xsens.yaml: frame imu_link, 100 Hz.
       /gnss also uses imu_link (Ryan, 21 October; same as Parsa's Webots sim).
       No noise yet. GNSS 10 Hz is a sim choice, not from the robot. -->
  <gazebo reference="imu_link">
    <sensor name="xsens_imu" type="imu">
      <topic>imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <!-- Absolute ENU orientation like the Xsens (yaw 0 = east). Parsa's navsat uses IMU yaw directly. -->
      <imu>
        <orientation_reference_frame>
          <localization>ENU</localization>
        </orientation_reference_frame>
      </imu>
    </sensor>
    <sensor name="xsens_gnss" type="navsat">
      <topic>navsat</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- IGVC stand-in: 3.5 in forward and 6.25 in above the IMU. Not a measurements.md value. -->
  <link name="velodyne">
    <visual>
      <geometry><cylinder radius="0.052" length="0.072"/></geometry>
      <material name="velodyne_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
  </link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <origin xyz="${p['velodyne_x']} 0 ${xsens_height + p['velodyne_z_above_imu']}" rpy="0 0 0"/>
  </joint>

  <!-- VLP-16 per docs/plans/project-assignments.md section 9: 16 beams, +/-15 deg (2 deg apart),
       360 deg at 0.2 deg (1800 samples), 0.5-100 m, 10 Hz.
       Same contract as Paarseus/IGVC_ROS2 avros_sim (Webots VelodynePuck): /velodyne_points, frame velodyne.
       The velodyne link is lumped into base_link by the URDF->SDF fixed-joint reduction,
       so ignition_frame_id keeps the ROS frame_id as velodyne.
       Gazebo topic: /velodyne/points (PointCloudPacked), bridged to /velodyne_points. -->
  <gazebo reference="velodyne">
    <sensor name="vlp16" type="gpu_lidar">
      <topic>velodyne</topic>
      <ignition_frame_id>velodyne</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26179939</min_angle>
            <max_angle>0.26179939</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>100</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera boxes stand in for zed_wrapper's zed_macro. -->
  <link name="zed_front_camera_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="zed_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_front_camera_link"/>
    <!-- IGVC stand-in. avros_cam_sim calls this zed_front. 15 deg down. -->
    <origin xyz="${p['zed_front_x']} 0 ${xsens_height - p['zed_front_z_below_imu']}" rpy="0 ${radians(p['zed_front_pitch_deg'])} 0"/>
  </joint>

  <link name="zed_left_camera_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"/>
    </visual>
  </link>
  <joint name="zed_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_left_camera_link"/>
    <!-- IGVC stand-in. Faces left. -->
    <origin xyz="${p['zed_left_xy']} ${xsens_height + p['zed_left_z_above_imu']}" rpy="${p['zed_left_rpy']}"/>
  </joint>

  <link name="zed_right_camera_link">
    <visual>
      <geometry><box size="0.04 0.17 0.03"/></geometry>
      <material name="zed_black"/>
    </visual>
  </link>
  <joint name="zed_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_right_camera_link"/>
    <!-- IGVC stand-in. Faces right. -->
    <origin xyz="${p['zed_right_xy']} ${xsens_height + p['zed_right_z_above_imu']}" rpy="${p['zed_right_rpy']}"/>
  </joint>

  <!-- Optical frames: x right, y down, z forward. -->
  <link name="zed_left_optical_frame"/>
  <joint name="zed_left_optical_joint" type="fixed">
    <parent link="zed_left_camera_link"/>
    <child link="zed_left_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="zed_center_optical_frame"/>
  <joint name="zed_center_optical_joint" type="fixed">
    <parent link="zed_front_camera_link"/>
    <child link="zed_center_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="zed_right_optical_frame"/>
  <joint name="zed_right_optical_joint" type="fixed">
    <parent link="zed_right_camera_link"/>
    <child link="zed_right_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- ZED X sim cameras, following Paarseus/IGVC_ROS2 avros_bringup/config/zed_front.yaml
       (grab SVGA, published downscaled to 480x300, 8 Hz, depth 0.3-15 m) and the topics
       avros_perception subscribes to (zed_wrapper v5.x paths):
         /zed_<cam>/zed_node/rgb/color/rect/image, .../rgb/color/rect/camera_info,
         /zed_<cam>/zed_node/point_cloud/cloud_registered (organized, same stamp as the image).
       HFOV 110 deg is the ZED X 2.2 mm datasheet value, not a measurement. Stand-in.
       Two sensors per camera because one Gazebo sensor carries one frame_id:
         camera       -> image + camera_info, frame = optical frame (z forward)
         rgbd_camera  -> organized cloud, frame = camera link (Gazebo cloud is x forward)
       Same rate and pose, so both render on the same sim step and share header.stamp.
       Gazebo topics: zed_<cam>/rgb/image, zed_<cam>/rgb/camera_info, zed_<cam>/depth/points. -->
  <xacro:macro name="zed_camera_block">
    <horizontal_fov>1.91986218</horizontal_fov>
    <image>
      <width>480</width>
      <height>300</height>
      <format>R8G8B8</format>
    </image>
    <clip>
      <near>0.3</near>
      <far>15</far>
    </clip>
  </xacro:macro>
  <xacro:macro name="zed_sim" params="cam link frame">
    <gazebo reference="${link}">
      <sensor name="zed_${cam}_rgb" type="camera">
        <topic>zed_${cam}/rgb/image</topic>
        <ignition_frame_id>${frame}</ignition_frame_id>
        <update_rate>8</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <xacro:zed_camera_block/>
        </camera>
      </sensor>
      <sensor name="zed_${cam}_depth" type="rgbd_camera">
        <topic>zed_${cam}/depth</topic>
        <ignition_frame_id>${link}</ignition_frame_id>
        <update_rate>8</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <xacro:zed_camera_block/>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>15</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:zed_sim cam="front" link="zed_front_camera_link" frame="zed_center_optical_frame"/>
  <xacro:zed_sim cam="left"  link="zed_left_camera_link"  frame="zed_left_optical_frame"/>
  <xacro:zed_sim cam="right" link="zed_right_camera_link" frame="zed_right_optical_frame"/>

  <!-- Track stand-ins. Radius and separation come from Ryan's taped numbers. -->
  <xacro:property name="wheel_radius" value="${p['sprocket_radius']}"/>
  <xacro:property name="wheel_separation" value="${tread_y * 2}"/>

  <xacro:macro name="drive_wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${tread_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${tread_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${p['wheel_mass']}"/>
        <inertia ixx="${p['wheel_inertia']}" ixy="0" ixz="0" iyy="${p['wheel_inertia']}" iyz="0" izz="${p['wheel_inertia']}"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Four contacts so the chassis cannot pitch onto its nose. -->
  <xacro:drive_wheel prefix="left_rear" x="${p['wheel_x_rear']}" y="${tread_y}"/>
  <xacro:drive_wheel prefix="left_front" x="${p['wheel_x_front']}" y="${tread_y}"/>
  <xacro:drive_wheel prefix="right_rear" x="${p['wheel_x_rear']}" y="${-tread_y}"/>
  <xacro:drive_wheel prefix="right_front" x="${p['wheel_x_front']}" y="${-tread_y}"/>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_rear_wheel_joint</left_joint>
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <!-- Defaults: /model/tracked_rover/cmd_vel, /odometry, /tf -->
      <max_linear_velocity>${p['max_linear_velocity']}</max_linear_velocity>
      <min_linear_velocity>${p['min_linear_velocity']}</min_linear_velocity>
      <max_angular_velocity>${p['max_angular_velocity']}</max_angular_velocity>
      <min_angular_velocity>${p['min_angular_velocity']}</min_angular_velocity>
    </plugin>
  </gazebo>

</robot>
