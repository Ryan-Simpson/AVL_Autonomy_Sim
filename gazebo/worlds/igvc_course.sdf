<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="igvc_course">
    <!--
      Default autonomy-sim world.
      IGVC course from Hosei Orange (Apache-2.0).
      Model: gazebo/models/orange_igvc
      Rover spawn: 0 0.1 0.05, yaw 0 (south lane centerline, facing east).

      Fortress often crushes COLLADA colors unless scene ambient is high.
      Ambient near white shows texture colors; sun adds direction.
    -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- IMU (/imu/data) and NavSat (/gnss) sensors on imu_link. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
    <!-- World origin = Parsa's navsat.yaml datum (CPP test spot, Paarseus/IGVC_ROS2), so his
         navsat_transform runs unchanged and world (0,0) is the map origin. ENU: x east, y north. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>34.05930007</latitude_deg>
      <longitude_deg>-117.82186044</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- Renders gpu_lidar (VLP-16 on the velodyne link). -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.95 0.95 0.95 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.95 0.88 1</diffuse>
      <specular>0.05 0.05 0.04 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Plain ground beyond the 43 x 37 m course plane, 5 mm below it. Without it the side
         cameras look past the outer lines into empty background, which pulls Parsa's adaptive
         brightness ceiling up and hides the line. Gray 0.35 matches the course asphalt's
         rendered brightness (V ~123). -->
    <model name="outer_ground">
      <static>true</static>
      <pose>0 16.3 -0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://orange_igvc</uri>
      <name>orange_igvc</name>
      <pose>0 16.3 0 0 0 0</pose>
      <static>true</static>
    </include>
  </world>
</sdf>
