          <diffuse>0.35 0.9 0.35 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.08 0.2 0.08 1</emissive>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
