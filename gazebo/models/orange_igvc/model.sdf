<?xml version="1.0"?>
<sdf version="1.6">
  <model name="orange_igvc">
    <static>true</static>
    <!--ground-->
    <link name="ground">
      <visual name="visual">
        <geometry>
          <plane>
            <size>43 37</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/ground.png</albedo_map>
              <!-- Matte, non-metal ground so cameras see the texture's paint/asphalt
                   brightness (white paint V~255) instead of an ogre2 metal-darkened copy. -->
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <plane>
            <size>43 37</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
          <bounce/>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>
    </link>
    <!--ramp-->
    <link name="ramp_part1">
      <pose>0.9889 13 0.1484 0.148 0 1.570796</pose>
